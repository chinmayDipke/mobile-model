<?xml version="1.0" encoding="utf-8"?>
<!--
  Shaped like an Android settings screen, because that is what this is: state
  you check and switches you fix. The previous version was a stack of identical
  full-width buttons, which is not how anything on this platform looks.

  Rules followed here:
   - one accent colour, used only where it means something
   - state lives on the right of a row, as a dot, not as a paragraph
   - sections are labelled and separated by space, not by boxes inside boxes
   - 8dp grid; row height 56dp so every target clears the 48dp minimum
   - type scale 32 / 15 / 13 / 11, and nothing in between
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="48dp"
            android:letterSpacing="-0.02"
            android:text="Airgap"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp"
            android:text="Catches UPI scams on this phone."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- engine -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="ENGINE"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/engineName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Loading…"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/engineDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- protection -->
        <TextView
            style="@style/SectionLabel"
            android:text="PROTECTION" />

        <LinearLayout
            android:id="@+id/smsPermButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Messages" />

            <TextView
                android:id="@+id/smsState"
                style="@style/RowState" />

            <View
                android:id="@+id/smsDot"
                style="@style/RowDot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayPermButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Warning over other apps" />

            <TextView
                android:id="@+id/overlayState"
                style="@style/RowState" />

            <View
                android:id="@+id/overlayDot"
                style="@style/RowDot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notifPermButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Payment app alerts" />

            <TextView
                android:id="@+id/notifState"
                style="@style/RowState" />

            <View
                android:id="@+id/notifDot"
                style="@style/RowDot" />
        </LinearLayout>

        <!-- tools -->
        <TextView
            style="@style/SectionLabel"
            android:text="CHECK SOMETHING" />

        <LinearLayout
            android:id="@+id/scanQrButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Scan a QR code" />

            <TextView style="@style/RowChevron" android:text="›" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="What Airgap has blocked" />

            <TextView
                android:id="@+id/historyCountBadge"
                style="@style/RowState" />

            <TextView style="@style/RowChevron" android:text="›" />
        </LinearLayout>

        <!-- dev -->
        <TextView
            style="@style/SectionLabel"
            android:text="TRY IT" />

        <LinearLayout
            android:id="@+id/demoScamButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Simulate a scam message" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/demoCleanButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Simulate a genuine bank SMS" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/runTestsButton"
            style="@style/Row">

            <TextView style="@style/RowLabel" android:text="Run the 55-message test set" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
