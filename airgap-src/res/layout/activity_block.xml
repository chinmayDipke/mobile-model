<?xml version="1.0" encoding="utf-8"?>
<!--
  The full-screen interrupt — the screen a judge looks at, and the screen a
  frightened person reads at the worst possible moment.

  Same type scale and spacing as the other two screens, so this reads as the
  same app rather than a separate alert dialog someone bolted on. What makes it
  different is weight, not a different design language: bigger headline, more
  air, one action.

  Calm, not shouting. Red-alert styling makes people panic and tap whatever
  removes it — which is the behaviour we exist to prevent.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="44dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Warning"
            android:src="@drawable/ic_warning_shield" />

        <TextView
            android:id="@+id/patternLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.08"
            android:text="Scam blocked"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- the sentence that is also read aloud -->
        <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginStart="0dp"
            android:text="THE MESSAGE" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_quote"
            android:lineSpacingMultiplier="1.35"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/metaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No network was used."
            android:textColor="@color/ok"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/btn_primary"
            android:letterSpacing="0"
            android:text="Close this"
            android:textAllCaps="false"
            android:textColor="@color/on_accent_fill"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ignoreButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:letterSpacing="0"
            android:text="I understand the risk, continue"
            android:textAllCaps="false"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
