<?xml version="1.0" encoding="utf-8"?>
<!--
  LIGHT. The dark set lives in values-night/ and Android picks between them, so
  the app follows whatever the phone is already set to instead of forcing a look.

  Names say what a colour is FOR, not what it looks like - that is the only
  reason a second theme is cheap rather than a rewrite.
-->
<resources>
    <color name="bg">#FAFAF9</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#F1F1EF</color>
    <color name="hairline">#E3E3E0</color>

    <color name="text_primary">#17181C</color>
    <color name="text_secondary">#5F626B</color>
    <color name="text_tertiary">#8A8D96</color>

    <!-- Darker on light so it still clears contrast on white. -->
    <color name="accent">#8A5A00</color>
    <color name="accent_fill">#F0B31C</color>
    <color name="on_accent_fill">#17181C</color>

    <color name="ok">#1F7A4D</color>
    <color name="bad">#B4432B</color>

    <color name="ripple">#14000000</color>
</resources>
